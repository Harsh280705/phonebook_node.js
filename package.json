{
  "name": "phonebook-nodejs",
  "version": "1.0.0",
  "description": "Phonebook API (Node.js + Express + MongoDB) — port of the Java Spring Boot backend",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "populate": "node src/server.js populate",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
